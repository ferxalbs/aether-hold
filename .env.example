# Select the real provider explicitly outside local simulation.
HOLD_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Development-only simulation controls. Never use HOLD_PROVIDER=fake in production.
HOLD_FAKE_FAILURE=0
HOLD_FAKE_DELAY_MS=0

# Optional Evidence provider. Evidence is conditional and never runs for harmless drafts automatically.
HOLD_EVIDENCE_ENABLED=0
EVIDENCE_SEARCH_URL=
EVIDENCE_SEARCH_API_KEY=

# Production protection. Set a non-default random salt and explicit ceilings before exposure.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HOLD_RATE_LIMIT_SALT=
HOLD_RATE_LIMIT_REQUESTS=30
HOLD_EVIDENCE_RATE_LIMIT_REQUESTS=10
HOLD_RERANK_RATE_LIMIT_REQUESTS=20
HOLD_RATE_LIMIT_WINDOW_SECONDS=60
HOLD_MAX_REQUESTS_PER_MINUTE=30
HOLD_DAILY_SPEND_USD=
HOLD_HOURLY_SPEND_USD=
HOLD_EVIDENCE_DAILY_SPEND_USD=
HOLD_EVIDENCE_HOURLY_SPEND_USD=
HOLD_ESTIMATED_COST_PER_REQUEST_USD=0.01
